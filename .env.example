# Orbit environment template.
# Copy to `.env` and fill in real values: cp .env.example .env
# `.env` is gitignored; NEVER commit real keys. Canonical copy lives in ~/.orbit-supabase.env.
#
# Where each value comes from:
#   SUPABASE_URL / SUPABASE_ANON_KEY  -> Supabase dashboard > Settings > API
#     (the anon key is publishable and is also embedded in SupabaseService.swift;
#      Row Level Security is what protects data)
#   SUPABASE_SERVICE_ROLE_KEY         -> same page. BYPASSES RLS. Server-side only,
#                                        never ships in the app.
#   SUPABASE_DB_PASSWORD              -> Supabase dashboard > Settings > Database
#   SUPABASE_DB_URL_POOLER            -> session pooler connection string (IPv4);
#                                        URL-encode special chars in the password
#   GOOGLE_OAUTH_CLIENT_ID/SECRET     -> Google Cloud Console > Credentials >
#                                        OAuth web client (secret starts GOCSPX-)

SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_DB_URL_POOLER=postgresql://postgres.your-project-ref:url-encoded-password@aws-1-region.pooler.supabase.com:5432/postgres
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-secret
#   RESEND_API_KEY                    -> resend.com > API Keys (sending-only is fine;
#                                        also used as the Supabase SMTP password)
RESEND_API_KEY=re_your-key
#   SUPABASE_ACCESS_TOKEN             -> supabase.com/dashboard/account/tokens
#                                        (Management API; account-wide, revocable)
SUPABASE_ACCESS_TOKEN=sbp_your-token
